# ─── Runtime data ────────────────────────────────────────────
# All mutable state (database, uploads, music, scraper cache) lives under one
# directory, kept outside the source tree. Relative paths resolve against the
# project root, never against the current working directory.
VAR_DIR=./var
# Optional overrides — only needed to split state across separate volumes.
# Relative paths below resolve against VAR_DIR.
# SQLITE_PATH=db/myweb.db
# UPLOAD_DIR=uploads
# MUSIC_DIR=music
# FEEDS_DIR=feeds

# ─── Database ────────────────────────────────────────────────
# Options: sqlite | mysql | postgresql
DB_TYPE=sqlite
# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=yourpassword
MYSQL_DB=myweb
# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=yourpassword
PG_DB=myweb

# ─── Auth ────────────────────────────────────────────────────
# MUST be changed before deploying: it signs both the login JWT and the captcha.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-secret-key
JWT_EXPIRE_HOURS=72
AUTH_COOKIE_NAME=mw_auth
CSRF_COOKIE_NAME=mw_csrf
# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
COOKIE_PATH=/

# ─── AI Provider ─────────────────────────────────────────────
# Options: deepseek | gemini | zhipu | openai | ollama | custom
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

ZHIPU_API_KEY=xxx
ZHIPU_MODEL=glm-4.7-flash
ZHIPU_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

CUSTOM_API_URL=https://your-endpoint/v1/chat/completions
CUSTOM_API_KEY=xxx
CUSTOM_MODEL=your-model

# ─── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost,http://localhost:8000
# Auto-reload on file changes. Local development ONLY — never true in production.
DEV_RELOAD=false

# ─── Upload Limits ───────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50
MAX_ATTACHMENT_SIZE_MB=100
